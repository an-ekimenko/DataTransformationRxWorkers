<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <!-- =================================================================== -->
    <!-- Parent Aggregator Reference                                         -->
    <!-- =================================================================== -->
    <parent>
        <groupId>by.beloil.workers</groupId>
        <artifactId>DataTransformationRxWorkers</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>AppLauncher</artifactId>
    <name>AppLauncher</name>

    <dependencies>
        <!-- Internal Sub-Module Coupling Inter-Dependencies -->
        <dependency>
            <groupId>by.beloil.workers</groupId>
            <artifactId>shared-module</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>by.beloil.workers</groupId>
            <artifactId>jck_ActiveClients</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>by.beloil.workers</groupId>
            <artifactId>FinancialIndicators</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- Core Framework foundations -->
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
        </dependency>
        <!-- Native Microsoft SQL Server JDBC Driver Link for Runtime Class-Path -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>


    </dependencies>

    <build>
        <finalName>AppLauncher</finalName>
        
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- =================================================================== -->
            <!-- 1. Gathers ONLY external third-party libraries into external folder -->
            <!-- =================================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.10.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../../${lib.dir}</outputDirectory>
                            <excludeGroupIds>by.beloil.workers</excludeGroupIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- =================================================================== -->
            <!-- 2. AUTOMATICALLY generates perfect MANIFEST.MF Class-Path entries  -->
            <!-- =================================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>rx.RxSchedulerMain</mainClass>
                            <!-- Force Maven to automatically resolve all transitive jars -->
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>../${lib.dir}/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- =================================================================== -->
            <!-- 3. Shades internal modules into Fat JAR, MERGING auto manifest      -->
            <!-- =================================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <promoteTransitiveDependencies>false</promoteTransitiveDependencies>
                            <artifactSet>
                                <includes>
                                    <include>by.beloil.workers:*</include>
                                </includes>
                            </artifactSet>
                            <!-- 
                                AUTOMATIC BRIDGING: Instructs shade to parse, preserve and merge 
                                the manifest entries built by maven-jar-plugin above.
                            -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>rx.RxSchedulerMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- =================================================================== -->
            <!-- 4. Relocates the finalized target runner JAR to the parent root     -->
            <!-- =================================================================== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-jar-to-root</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.parent.basedir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
