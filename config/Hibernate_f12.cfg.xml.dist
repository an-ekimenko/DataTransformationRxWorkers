<?xml version="1.0" encoding="UTF-8"?>

<!-- =================================================================== -->
<!-- Oracle Source Warehouse Database Connection Template Profile        -->
<!-- IMPORTANT: Copy this file to 'hibernate_f12.cfg.xml' and fill in keys. -->
<!-- =================================================================== -->
<hibernate-configuration>
    <session-factory>
        <!-- Oracle Database Connection Settings -->
        <property name="hibernate.connection.driver_class">oracle.jdbc.OracleDriver</property>
        <property name="hibernate.connection.url">jdbc:oracle:thin:@//YOUR_ORACLE_HOST:YOUR_PORT/YOUR_SERVICE_NAME</property>
        <property name="hibernate.connection.username">YOUR_ORACLE_USER</property>
        <property name="hibernate.connection.password">YOUR_ORACLE_PASSWORD</property>
        
        <!-- Oracle Legacy Community Dialect aligned with Hibernate 6.4+ -->
        <property name="hibernate.dialect">org.hibernate.community.dialect.OracleLegacyDialect</property>
        
        <!-- Infrastructure telemetry and performance mapping tracking -->
        <property name="hibernate.generate_statistics">true</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- NOTE: Persistent mapping declarations are completely omitted here. Managed via MS SQL. -->
    </session-factory>
</hibernate-configuration>